# Copy this file to .env and fill in your own values. Never commit .env.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=           # e.g. abc12345.ca-central-1.aws  (or orgname-accountname)
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=          # or leave blank and use a key pair below
SNOWFLAKE_PRIVATE_KEY_PATH=  # optional: path to rsa_key.p8 for key-pair auth
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=RESILIENCE
SNOWFLAKE_SCHEMA=RAW

# --- Tiger Data (Tiger Cloud / TimescaleDB) ---
# Full connection string from the Tiger console or `tiger db connection-string`
TIGER_DATABASE_URL=          # postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TIGER_SERVICE_ID=            # 10-character service id
