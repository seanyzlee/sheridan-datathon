# Copy this file to .env and fill in your own values. Never commit .env.

# --- Tiger Data (Tiger Cloud / TimescaleDB) ---
# Full connection string from the Tiger console or `tiger db connection-string`
TIGER_DATABASE_URL=          # postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TIGER_SERVICE_ID=            # 10-character service id
