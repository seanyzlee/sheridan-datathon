# Copy this file to .env and fill in your own values. Never commit .env.

# --- Tiger Data (Tiger Cloud / TimescaleDB) ---
# Full connection string from the Tiger console or `tiger db connection-string`
TIGER_DATABASE_URL=          # postgres://tsdbadmin:<password>@<host>:<port>/tsdb?sslmode=require
TIGER_SERVICE_ID=            # 10-character service id

# --- Gemini (optional) ---
# API key from Google AI Studio or the Google Cloud console. Used only to read twist cards the rule-based
# reader misses and to phrase the advisor note; the app works the same without it.
GEMINI_API_KEY=
GEMINI_MODEL=                # optional override for the card reader and note, e.g. gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=           # optional override for the assistant (tool calling), defaults to GEMINI_MODEL
