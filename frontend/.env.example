# Copy to .env.local and edit. All values are optional.

# mock = in-browser mock engine (default). live = call the FastAPI server.
VITE_DATA_SOURCE=mock

# Where the Vite dev server forwards /api/* in live mode.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Mock only: which engine the mock reports. js (default), cpp or numpy.
# Set to numpy to rehearse the "NumPy mode" fallback badge.
VITE_MOCK_ENGINE=js

# Hide panels whose backend isn't ready. Comma-separated, any of:
# time-machine, region-map, peers, twist-reader, bank
VITE_DISABLED_FEATURES=
